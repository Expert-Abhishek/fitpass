{
  "name": "fitness-app-monorepo",
  "version": "1.0.0",
  "main": "apps/mobile/index.js",
  "private": true,
  "scripts": {
    "start": "npm --prefix apps/mobile start",
    "dev": "npm --prefix apps/mobile run dev",
    "dev:mobile": "npm --prefix apps/mobile run dev",
    "dev:tunnel": "npm --prefix apps/mobile run dev -- --tunnel",
    "android": "npm --prefix apps/mobile run android",
    "ios": "npm --prefix apps/mobile run ios",
    "web": "npm --prefix apps/mobile run web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "npm --prefix apps/mobile run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0"
  }
}
