{
  "name": "fitness-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @fitness/mobile dev",
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @fitness/mobile dev",
    "dev:tunnel": "pnpm --filter @fitness/mobile dev -- --tunnel",
    "android": "pnpm --filter @fitness/mobile android",
    "ios": "pnpm --filter @fitness/mobile ios",
    "web": "pnpm --filter @fitness/mobile web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0"
  }
}
